{
  "name": "x",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "api": "tsx watch --env-file=.env src/api.ts",
    "worker": "tsx --env-file=.env src/worker.ts",
    "build": "tsc",
    "start": "node dist/db/migrate.js && node dist/main.js",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@webhook/signature": "workspace:*",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "24",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
